# ===== PostgreSQL =====
POSTGRES_USER=sua
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sua
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== Groq (LLM) =====
# Clé à créer sur https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ===== Embeddings (locaux : Groq ne propose pas d'embeddings) =====
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

# ===== RAG =====
# Tailles exprimées en caractères
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# Seuil de similarité cosinus en dessous duquel on refuse de répondre (à calibrer)
MIN_SCORE=0.35
MAX_UPLOAD_MB=20

# ===== Auth / API =====
JWT_SECRET=change_me_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Clé utilisée par n8n pour appeler les routes /internal
N8N_API_KEY=change_me_n8n_key

# Compte admin créé par scripts/seed_admin.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin

# ===== Frontend =====
BACKEND_URL=http://backend:8000
